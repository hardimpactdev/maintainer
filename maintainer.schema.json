{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/hardimpactdev/maintainer/blob/main/maintainer.schema.json",
    "title": "maintainer.json",
    "type": "object",
    "additionalProperties": false,
    "required": ["sides"],
    "properties": {
        "$schema": { "type": "string" },
        "checks": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
        },
        "sides": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "dir", "managers"],
                "properties": {
                    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
                    "dir": { "type": "string", "minLength": 1 },
                    "managers": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "enum": ["composer", "js"] }
                    }
                }
            }
        }
    }
}
