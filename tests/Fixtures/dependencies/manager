#!/usr/bin/env php
<?php

$name = basename($argv[0]);
$key = $name.' '.implode(' ', array_slice($argv, 1));
$age = getenv('npm_config_min_release_age');
$suffix = ($age !== false && $age !== '') ? '|min-release-age='.$age : '';
file_put_contents(getenv('DEPENDENCY_TEST_LOG'), $name.'|'.implode(' ', array_slice($argv, 1)).'|'.getcwd().$suffix."\n", FILE_APPEND);
// Composer has no installed inventory in a fresh VM. Fixture responses must
// not hide the empty, non-JSON output when audit is called without --locked.
if ($name === 'composer' && $argv[1] === 'audit' && ! is_dir('vendor') && ! in_array('--locked', $argv, true)) {
    fwrite(STDERR, "No packages - skipping audit.\n");
    exit(0);
}
$fixture = getenv('DEPENDENCY_TEST_FIXTURE');
if ($fixture) {
    $responses = json_decode(file_get_contents($fixture), true);
    $countsFile = $fixture.'.counts';
    $counts = is_file($countsFile) ? json_decode(file_get_contents($countsFile), true) : [];
    $n = $counts[$key] ?? 0;
    $counts[$key] = $n + 1;
    file_put_contents($countsFile, json_encode($counts));
    $items = $responses[$key] ?? null;
    if ($items !== null) {
        $response = $items[min($n, count($items) - 1)];
        echo isset($response['raw']) ? $response['raw'] : json_encode($response['data']);
        exit($response['code'] ?? 0);
    }
}
// npm 11.12 ignores min-release-age-exclude and still enforces min-release-age.
// A fresh security fix must pass --min-release-age=0. The pinned packageManager stays.
$isNpmInstall = ($name === 'vp' && ($argv[1] ?? '') === 'add') || ($name === 'npm' && ($argv[1] ?? '') === 'install');
if ($isNpmInstall && is_file('package.json')) {
    $manifest = json_decode((string) file_get_contents('package.json'), true);
    $declared = is_array($manifest) ? ($manifest['packageManager'] ?? '') : '';
    if (is_string($declared) && preg_match('/^npm@(\d+)\.(\d+)\.(\d+)/', $declared, $npm) === 1
        && version_compare($npm[1].'.'.$npm[2].'.'.$npm[3], '11.17.0', '<')
        && ! in_array('--min-release-age=0', $argv, true)) {
        $npmrc = is_file('.npmrc') ? (string) file_get_contents('.npmrc') : '';
        $wroteExclude = preg_match('/^\s*min-release-age-exclude\[\]\s*=/m', $npmrc) === 1;
        if ($wroteExclude || getenv('DEPENDENCY_TEST_NPM_FRESH') === '1') {
            if ($wroteExclude) {
                fwrite(STDERR, "npm warn Unknown project config \"min-release-age-exclude\". This will stop working in the next major version of npm.\n");
            }
            fwrite(STDERR, "npm error code ETARGET\nnpm error notarget No matching version found. The release is younger than the min-release-age cutoff.\n");
            exit(1);
        }
    }
}
if ($name === 'composer' && $argv[1] === 'require') {
    [$package, $range] = explode(':', $argv[2], 2);
    $file = 'composer.json';
    $section = in_array('--dev', $argv, true) ? 'require-dev' : 'require';
} elseif ($name === 'vp' && $argv[1] === 'add') {
    $split = strrpos($argv[2], '@');
    $package = substr($argv[2], 0, $split);
    $range = substr($argv[2], $split + 1);
    $file = 'package.json';
    $section = in_array('--save-dev', $argv, true) ? 'devDependencies' : (in_array('--save-optional', $argv, true) ? 'optionalDependencies' : 'dependencies');
} elseif ($name === 'npm' && ($argv[1] ?? '') === 'install') {
    $split = strrpos($argv[2], '@');
    $package = substr($argv[2], 0, $split);
    $range = substr($argv[2], $split + 1);
    $file = 'package.json';
    $section = in_array('--save-dev', $argv, true) ? 'devDependencies' : (in_array('--save-optional', $argv, true) ? 'optionalDependencies' : 'dependencies');
} elseif ($name === 'npx' && ($argv[1] ?? '') === 'expo' && ($argv[2] ?? '') === 'install' && isset($argv[3]) && $argv[3] !== '--fix') {
    $split = strrpos($argv[3], '@');
    $package = substr($argv[3], 0, $split);
    $range = substr($argv[3], $split + 1);
    $file = 'package.json';
    $section = 'dependencies';
}
if (isset($file)) {
    $data = json_decode(file_get_contents($file), true);
    $data[$section][$package] = $range;
    file_put_contents($file, json_encode($data));
}
exit((int) (getenv($name === 'composer' ? 'DEPENDENCY_TEST_COMPOSER_EXIT' : ($name === 'npm' ? 'DEPENDENCY_TEST_NPM_EXIT' : 'DEPENDENCY_TEST_VP_EXIT')) ?: 0));
