{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/hardimpactdev/maintainer/blob/main/maintainer.schema.json",
    "title": "maintainer.json",
    "type": "object",
    "additionalProperties": false,
    "required": ["paths"],
    "properties": {
        "$schema": { "type": "string" },
        "checks": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
        },
        "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
        }
    }
}
